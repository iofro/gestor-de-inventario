# Ignorar Java runtime y vendor pesado
svfe-api-firmador/vendor/
svfe-api-firmador/vendor/jre/
svfe-api-firmador/vendor/jdk/

# Ignorar certificados y otros archivos sensibles
svfe-api-firmador/uploads/

# Ignorar todo target menos el jar final
svfe-api-firmador/target/*
!svfe-api-firmador/target/svfe-api-firmador-*.jar

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Build/output
/build/*.exe
/build/*.log
dist/
*.spec
assets/app.ico

# Logs y DB locales
*.log
*.db
facturacion.log
inventario.db

# Tests cache
tests/__pycache__/
/.out/
.coverage
.coverage*
node_modules/
